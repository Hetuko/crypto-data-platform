# Copy to .env, then replace every placeholder with a unique local value.
AIRFLOW_UID=50000
FERNET_KEY=replace-with-a-generated-url-safe-fernet-key
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-this-before-first-start

POSTGRES_HOST=crypto_db
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change-me
AIRFLOW_CONN_CRYPTO_PG=postgresql://crypto:URL_ENCODED_PASSWORD@crypto_db:5432/crypto
